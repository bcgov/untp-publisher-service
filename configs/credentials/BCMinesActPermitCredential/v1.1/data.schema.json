{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://untp-publisher.example/schemas/BCMinesActPermitCredential/v1.1/data.schema.json",
  "title": "BCMinesActPermitCredential publish data",
  "description": "JSON Schema for the ``data`` object on POST /credentials/publish (and test-suite build).",
  "type": "object",
  "additionalProperties": false,
  "x-publisher-pointers": {
    "cardinality": "/permit/identifier",
    "entity": "/permittee/identifier"
  },
  "required": ["permit", "permittee", "mine"],
  "properties": {
    "permit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "issuanceDate"],
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "Mines Act permit number (cardinality id).",
          "x-publisher-role": "cardinality"
        },
        "issuanceDate": {
          "type": "string",
          "minLength": 1,
          "description": "Permit issuance / assessment date (ISO-8601 date or datetime)."
        }
      }
    },
    "permittee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Legal name of the permit holder.",
          "x-publisher-role": "entityName"
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "BC Registry (or scheme) identifier for the permittee.",
          "x-publisher-role": "entity"
        }
      }
    },
    "mine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Mine / facility name."
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "description": "Registered mine number (BC Mine Information)."
        },
        "infoPageId": {
          "type": "string",
          "description": "Optional NRS mine page id for authorizations evidence URL."
        },
        "locationInformation": {
          "type": "string",
          "description": "Optional Plus Code or location URI."
        },
        "IDverifiedByCAB": {
          "type": "boolean"
        },
        "geoLocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" }
          }
        }
      }
    },
    "commodities": {
      "type": "array",
      "description": "Optional product / commodity scope (may be empty).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string"
          },
          "registeredId": {
            "type": "string"
          },
          "IDverifiedByCAB": {
            "type": "boolean"
          }
        }
      }
    }
  }
}

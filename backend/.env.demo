# Publisher
DOMAIN='example.com'
PUBLISHER_WITNESS_ID='did:key:z6M...'

# OrgBook (read-only search API for entity lookup; no VC service integration)
ORGBOOK_URL='https://dev.orgbook.gov.bc.ca'

# MongoDB — use either a full URI or host/port/user/password fields:
# MONGO_URI='mongodb://user:pass@host:55128/untp-publisher'
# MONGO_HOST='localhost'
# MONGO_PORT='27017'
# MONGO_USER='dev'
# MONGO_PASSWORD='dev'
# MONGO_DB='untp-publisher'
# MONGO_AUTH_SOURCE='admin'   # split mode only, when auth DB differs from app DB

# DID Web server (must match config setting DID_WEB_SERVER_URL)

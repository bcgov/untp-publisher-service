# When true, only /server/status and /test-suite/* are registered (validator / CI harness).
# TEST_SUITE=true

# Publisher
PUBLISHER_DOMAIN='example.com'
PUBLISHER_WITNESS_ID='did:key:z6M...'


# MongoDB — use either a full URI or host/port/user/password fields.
# Database selection always uses MONGO_DB (URI path is ignored).
# MONGO_URI='mongodb://user:pass@host:55128'
# MONGO_HOST='localhost'
# MONGO_PORT='27017'
# MONGO_USER='dev'
# MONGO_PASSWORD='dev'
# MONGO_DB='untp-publisher'
# MONGO_AUTH_SOURCE='admin'   # split mode only, when auth DB differs from app DB

# WebVH / DID web server (hostname used for issuer did:web from issuers.yaml)
WEBVH_SERVER_URL='https://registry-dev.digitaltrust.gov.bc.ca'

# Traction
TRACTION_API_URL='https://traction-tenant-proxy-dev.apps.silver.devops.gov.bc.ca'
TRACTION_API_KEY=''
TRACTION_TENANT_ID=''

# Digital Trust Toolkit
ISSUER_REGISTRY_URL='https://bcgov.github.io/digital-trust-toolkit/registrations/issuers/dev.json'
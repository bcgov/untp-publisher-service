PUBLISHER_WITNESS_ID='did:key:z6M...'
PROJECT_TITLE='UNTP Publisher'
PROJECT_VERSION='v0'
LANDING_TAGLINE='Publish UNTP-aligned verifiable credentials through BC Traction.'
# LANDING_DESCRIPTION=''  # optional; omit or leave empty to hide
